  "components": {
    "schemas": {
      "AnalyticsEventBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AnalyticsEventInput"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Events"
          }
        },
        "type": "object",
        "title": "AnalyticsEventBatch"
      },
      "AnalyticsEventInput": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/EventName"
          },
          "geohash": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Geohash"
          },
          "post_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Post Id"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AnalyticsEventInput"
      },
      "AnalyticsEventResult": {
        "properties": {
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "stored": {
            "type": "integer",
            "title": "Stored"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "stored"
        ],
        "title": "AnalyticsEventResult"
      },
      "DeviceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "pseudonym": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pseudonym"
          },
          "new_neighbour": {
            "type": "boolean",
            "title": "New Neighbour"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "experiment_segment": {
            "type": "integer",
            "title": "Experiment Segment"
          },
          "experiment_flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Experiment Flags"
          },
          "analytics_consent": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analytics Consent"
          }
        },
        "type": "object",
        "required": [
          "id",
          "new_neighbour",
          "created_at",
          "experiment_segment",
          "experiment_flags"
        ],
        "title": "DeviceResponse"
      },
      "DeviceUpdate": {
        "properties": {
          "pseudonym": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "minLength": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pseudonym"
          },
          "analytics_consent": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analytics Consent"
          }
        },
        "type": "object",
        "title": "DeviceUpdate"
      },
      "EventName": {
        "type": "string",
        "enum": [
          "post_viewed",
          "post_created",
          "onboarding_completed"
        ],
        "title": "EventName"
      },
      "FeedItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "scope": {
            "$ref": "#/components/schemas/PostScope"
          },
          "display_address": {
            "type": "string",
            "title": "Display Address"
          },
          "geohash": {
            "type": "string",
            "title": "Geohash"
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance M"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "pseudonym": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pseudonym"
          },
          "new_neighbour": {
            "type": "boolean",
            "title": "New Neighbour",
            "default": true
          },
          "media": {
            "items": {
              "$ref": "#/components/schemas/MediaInfo"
            },
            "type": "array",
            "title": "Media"
          }
        },
        "type": "object",
        "required": [
          "id",
          "body",
          "scope",
          "display_address",
          "geohash",
          "created_at"
        ],
        "title": "FeedItem"
      },
      "FeedResponse": {
        "properties": {
          "posts": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "type": "array",
            "title": "Posts"
          },
          "effective_radius_m": {
            "type": "integer",
            "title": "Effective Radius M"
          },
          "target_count": {
            "type": "integer",
            "title": "Target Count"
          }
        },
        "type": "object",
        "required": [
          "posts",
          "effective_radius_m",
          "target_count"
        ],
        "title": "FeedResponse"
      },
      "GeocodeResponse": {
        "properties": {
          "display_address": {
            "type": "string",
            "title": "Display Address"
          },
          "cell": {
            "type": "string",
            "title": "Cell"
          },
          "cell_center_latitude": {
            "type": "number",
            "title": "Cell Center Latitude"
          },
          "cell_center_longitude": {
            "type": "number",
            "title": "Cell Center Longitude"
          }
        },
        "type": "object",
        "required": [
          "display_address",
          "cell",
          "cell_center_latitude",
          "cell_center_longitude"
        ],
        "title": "GeocodeResponse"
      },
      "GeocodeSuggestResponse": {
        "properties": {
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          }
        },
        "type": "object",
        "required": [
          "suggestions"
        ],
        "title": "GeocodeSuggestResponse",
        "description": "Autocomplete results: display strings only, never coordinates."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "app": {
            "type": "string",
            "title": "App"
          }
        },
        "type": "object",
        "required": [
          "status",
          "app"
        ],
        "title": "HealthResponse"
      },
      "HeatmapTileResponse": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "FeatureCollection"
          },
          "features": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "title": "HeatmapTileResponse"
      },
      "LocationInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_address": {
            "type": "string",
            "title": "Display Address"
          },
          "geohash": {
            "type": "string",
            "title": "Geohash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_address",
          "geohash"
        ],
        "title": "LocationInfo"
      },
      "MediaInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
