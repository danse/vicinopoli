      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Readiness probe: downstream dependencies must be reachable.\n\nReturns 200 only when the database and the object store both answer;\notherwise 503 with the per-dependency results so operators can see what\nfailed.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
