# vicinopoli reverse proxy (local development and e2e).
# Local development here uses rootless Docker mapping Caddy's container :80 to
# the host :8080 (see docker-compose.yml). Route definitions are shared with
# production via deploy/Caddyfile.snippets; only the site address and
# site-level options differ.

:80 {
	import Caddyfile.snippets

	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}
