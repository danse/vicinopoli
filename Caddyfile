# vicinopoli reverse proxy.
# Local development here uses rootless Docker mapping Caddy's container :80 to
# the host :8080 (see docker-compose.yml). For production, replace the site
# address with the registered domain and Caddy will provision TLS automatically.

:80 {
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /healthz {
		reverse_proxy backend:8000
	}

	handle /readyz {
		reverse_proxy backend:8000
	}

	handle /metrics {
		reverse_proxy backend:8000
	}

	handle /media/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}
