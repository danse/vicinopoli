# vicinopoli backend configuration (copy to .env for local runs).
# In docker-compose these are set directly in docker-compose.yml.

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://vicinopoli:vicinopoli@localhost:5432/vicinopoli

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_SECURE=false

# Geocoding
# GEOCODER_MODE=static (default, deterministic dev/tests) | photon | nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# Observability (optional)
SENTRY_DSN=

# Shared token for the internal admin firehose (X-Admin-Token header). If unset
# or empty, all admin endpoints fail closed with 401.
# ADMIN_TOKEN=change-me

# Push notifications (ADR 0025).
# PUSH_SENDER=mock (default, dev/test) | webpush (production).
# VAPID keys are base64url raw P-256 values. Leave unset in dev to auto-generate
# an ephemeral pair at startup. In production set PUSH_SENDER=webpush AND stable
# keys — regenerating them invalidates every existing subscription on restart.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@vicinopoli.it
