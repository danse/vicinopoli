# Production secrets — copy to the VPS as ~/vicinopoli/.env (chmod 600).
# DO NOT COMMIT. Generate strong values, e.g. with:
#   openssl rand -hex 32

# Public hostname of the VPS.
# Must point (DNS A/AAAA record) at the VPS public IP. Caddy provisions a
# Let's Encrypt certificate automatically for it.
DOMAIN=vicinopoli.it

# Public base URL for uploaded media (e.g. photos/voice). Must match DOMAIN;
# presigned URLs are built from it (backend/app/core/config.py).
MEDIA_PUBLIC_BASE_URL=https://vicinopoli.it/media

# PostGIS
POSTGRES_USER=vicinopoli
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=vicinopoli

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG

# Observability (optional)
SENTRY_DSN=
