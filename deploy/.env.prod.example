# Production secrets — copy to the VPS as ~/vicinopoli/.env (chmod 600).
# DO NOT COMMIT. Generate strong values, e.g. with:
#   openssl rand -hex 32

# Public address of the VPS. Choose ONE:
#   - a hostname you own          e.g. vicinopoli.example.com
#   - a free sslip.io hostname    e.g. 203.0.113.7.sslip.io  (real HTTPS cert, no purchase)
#   - the bare IP, no TLS         e.g. 203.0.113.7            (Caddy serves plain HTTP)
# DNS must resolve to the VPS for HTTPS modes (the IP itself always does).
DOMAIN=vicinopoli.example.com

# PostGIS
POSTGRES_USER=vicinopoli
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=vicinopoli

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG

# Observability (optional)
SENTRY_DSN=
