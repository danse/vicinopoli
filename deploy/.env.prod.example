# Production secrets — copy to the VPS as ~/vicinopoli/.env (chmod 600).
# DO NOT COMMIT. Generate strong values, e.g. with:
#   openssl rand -hex 32

# Public hostname of the VPS.
# Must point (DNS A/AAAA record) at the VPS public IP. Caddy provisions a
# Let's Encrypt certificate automatically for it.
DOMAIN=vicinopoli.it

# Public base URL for uploaded media (e.g. photos/voice). Must match DOMAIN;
# presigned URLs are built from it (backend/app/core/config.py).
MEDIA_PUBLIC_BASE_URL=https://vicinopoli.it/media

# Geocoder: production MUST be a live provider. "static" is the default config
# and only resolves a handful of hardcoded test addresses — any real address
# then fails to publish. "photon" uses the public photon.komoot.io API (no key)
# and is the current production choice; self-hosting photon is planned.
GEOCODER_MODE=photon
PHOTON_BASE_URL=https://photon.komoot.io

# PostGIS
POSTGRES_USER=vicinopoli
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=vicinopoli

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG

# Observability (optional). Passed to BOTH the backend (error reporting) and
# the frontend build (VITE_SENTRY_DSN), so client-side errors are captured too.
SENTRY_DSN=

# Support email shown on the /support page (mailto link) in production.
# Defaults to info@vicinopoli.it when unset.
VITE_SUPPORT_EMAIL=info@vicinopoli.it

# Grafana admin password (observability UI). Prometheus + Grafana run inside
# the prod stack but are bound to 127.0.0.1 on the VPS only — reach them via an
# SSH tunnel (see deploy/README.md). The app never serves them publicly.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG

# Shared token for the internal admin firehose. The admin app is bound to
# 127.0.0.1:8081 on the VPS only (reach it via an SSH tunnel, see
# deploy/README.md); requests must send it as the X-Admin-Token header.
ADMIN_TOKEN=CHANGE_ME_STRONG
