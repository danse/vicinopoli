# vicinopoli production reverse proxy (Hetzner VPS).
#
# Site address comes from the $DOMAIN env var (set in /opt/vicinopoli/.env).
# With vicinopoli.it Caddy provisions a Let's Encrypt cert automatically and
# redirects :80 -> :443. A bare IP (no DNS) would serve plain HTTP on :80.
#
# Route definitions are shared with the dev/e2e stack via Caddyfile.snippets;
# only the site address and site-level options differ here.
#
# Place this via deploy/docker-compose.prod.yml (mounted read-only).

{$DOMAIN:localhost} {
	import Caddyfile.snippets

	handle {
		reverse_proxy frontend:80
	}

	encode gzip zstd

	# Basic hardening headers (PWA benefits from cache-busting asset hashes)
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
