# vicinopoli frontend configuration (copy to .env for local dev).
# Variables prefixed with VITE_ are exposed to the client bundle.

VITE_API_BASE_URL=/api
VITE_SENTRY_DSN=
# Support email shown on the /support page (mailto link).
VITE_SUPPORT_EMAIL=info@vicinopoli.it
# Base URL of the public app, used to build "open the zone" links in the admin
# tool. In dev this is the public nginx (make up); in prod the Caddy domain.
VITE_PUBLIC_BASE_URL=http://localhost:8080
# Google Ads / GA4 gtag id (e.g. AW-123456789). Empty in dev: the consent-gated
# Google tag is then never loaded (ADR 0026).
VITE_GTAG_ID=
